# ═══════════════════════════════════════════════════════════════════
# LernWerkstatt — configuration template
# Copy:  cp .env.example .env   then fill in the LLM endpoint(s).
# Commented-out lines show the default that applies when the line is absent.
# Every variable the application reads is listed here.
# ═══════════════════════════════════════════════════════════════════

# ── LLM1: the strong model (required) ───────────────────────────────
# Gap analysis, detailed plans, scripts, chapter assembly, exercises,
# final test, critique and revision.
# Any OpenAI-compatible endpoint (vLLM, TGI, a hosted API).
LLM1_BASE_URL=https://llm.example.org/v1
# Leave empty for endpoints without authentication.
LLM1_API_KEY=
LLM1_MODEL=your-model-name
# Model family; controls how reasoning ("thinking") is switched on and off:
# qwen3 | kimi_k2 | glm | gemma4 | generic
LLM1_FAMILY=generic
# LLM1_THINKING=true
# LLM1_MAX_TOKENS=16000
# LLM1_TEMPERATURE=0.3
# LLM1_TIMEOUT=300
# LLM1_MAX_CONCURRENT=3

# ── LLM2: the fast model (optional; without it everything runs on LLM1) ──
# Learner profile, cross-context, simpler scripts, transformations,
# chapter metadata, quality checks, repair loop.
# Only used when both LLM2_BASE_URL and LLM2_MODEL are set.
# LLM2_BASE_URL=
# LLM2_API_KEY=            (default: LLM1_API_KEY)
# LLM2_MODEL=
# LLM2_FAMILY=             (default: LLM1_FAMILY)
# LLM2_THINKING=false
# LLM2_MAX_TOKENS=8000
# LLM2_TEMPERATURE=0.2
# LLM2_TIMEOUT=300
# LLM2_MAX_CONCURRENT=2

# ── Application ─────────────────────────────────────────────────────
# Name shown in the browser title and page heading.
# APP_TITLE=LernWerkstatt
# Interface language: en | de. If set, every session starts in it; if not,
# the browser's language decides, with English as the fallback. Users can
# switch in the interface either way. The language of the generated units
# is chosen per job and is independent of this.
# APP_LANGUAGE=
# Path prefix behind a reverse proxy, e.g. /lernwerkstatt. Empty locally.
# APP_ROOT_PATH=
# Largest accepted upload per file, in MB. A reverse proxy in front needs
# at least the same limit (nginx: client_max_body_size).
# APP_MAX_UPLOAD_MB=50
# Interface address. The default keeps it on this machine; the container
# image sets 0.0.0.0 so that the published port works.
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860
# Directory for the job register and all job folders (uploaded text,
# intermediate results, generated units). Relative paths are resolved
# against the directory the application is started from.
# WORK_DIR=work

# ── Embedder (optional) ─────────────────────────────────────────────
# Indexes uploaded material for retrieval and the fact check. Without it
# the material reaches the model only as excerpts.
# EMBEDDER_BASE_URL=
# EMBEDDER_API_KEY=
# EMBEDDER_MODEL=default

# ── Reranker (optional) ─────────────────────────────────────────────
# FULL endpoint URL, not just the host: requests are posted to exactly this
# address. Expected is the Cohere/Jina/TEI form:
#   request : {"query": …, "documents": [...], "top_n": n}
#   response: {"results": [{"index": i, "relevance_score": 0.87}, …]}
# Without relevance_score, retrieval gives a ranking but no relevance cut.
# RERANKER_BASE_URL=
# RERANKER_API_KEY=
# Only needed if the service requires a model name (Cohere, Jina).
# RERANKER_MODEL=

# ── Budget of the block phase ───────────────────────────────────────
# These tasks produce the largest outputs. The technical report counts
# truncated and empty answers, so adjust from measurement, not by guessing.
# BLOCKS_MAX_TOKENS=14000
# false = reasoning off (recommended: this phase is formatting work),
# true = on, empty = same as the task's model setting
# BLOCKS_THINKING=false

# ── Reasoning controls ──────────────────────────────────────────────
# Only for LLM*_FAMILY=generic, where reasoning cannot be switched off via
# chat_template_kwargs: if the endpoint understands `reasoning_effort`,
# the value that means "off" (e.g. low or none). Empty = not used.
# LLM_REASONING_EFFORT_OFF=
# JSON mode enables guided decoding. A model that reasons at the same time
# may be unable to emit its reasoning tokens and return nothing, so JSON
# mode switches reasoning off. Set true only if the endpoint demonstrably
# handles both together.
# LLM_JSON_THINKING=false

# ── Limits ──────────────────────────────────────────────────────────
# Size, in characters, up to which a chapter script is passed in full to
# the later steps. A longer script is not cut; it is replaced by a labelled
# structural summary (outline, learning goals, content points).
# MAX_SCRIPT_CONTEXT=60000

# ── Parallel operation ──────────────────────────────────────────────
# How many jobs compute at the same time. Further jobs wait visibly in a
# queue and start automatically. Higher finishes sooner but loads the
# endpoint more; too high leads to timeouts of individual requests.
# JOBS_PARALLEL=3
# Optional ceiling on concurrent requests across ALL jobs of the process.
# Default: none. Each job already has its own limits (LLM*_MAX_CONCURRENT).
# A process-wide ceiling acts as a queue without fairness: the first job
# takes the slots and later ones only follow as it drains. Set it only if
# the endpoint is overloaded by several jobs at once.
# LLM_GLOBAL_MAX_CONCURRENT=
